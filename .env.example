# DecisionMind AI Environment Configuration Template

# Server Port
PORT=5001

# Environment Mode
NODE_ENV=development

# Optional: Google Gemini API Key
# If omitted or left empty, the platform automatically runs its built-in,
# high-fidelity local multi-model consensus engine with zero external dependencies.
GEMINI_API_KEY=your_gemini_api_key_here

# Client API Proxy URL
VITE_API_URL=http://localhost:5001
